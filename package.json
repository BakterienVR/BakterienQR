{
  "name": "bakterieninfo",
  "version": "1.0.0",
  "private": true,
  "description": "BakterienInfo – Offline Android App (Capacitor)",
  "scripts": {
    "vendor": "node scripts/download-vendor.mjs",
    "www": "node scripts/prepare-www.mjs",
    "sync": "npm run www && npx cap sync android",
    "open:android": "npx cap open android",
    "apk": "npm run sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2"
  }
}
